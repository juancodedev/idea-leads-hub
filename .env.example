# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Instagram / Meta ─────────────────────────────────────
# Creá una app en https://developers.facebook.com → Instagram → Instagram Messaging
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Elegí cualquier string (ej: "webhook123") — debe coincidir con la config del webhook en Meta
META_VERIFY_TOKEN=your-webhook-verify-token

# Clave de 32 caracteres para encriptar tokens en Supabase (pgcrypto)
# Generala con: openssl rand -hex 16 (da 32 caracteres hex)
TOKEN_ENCRYPTION_KEY=your-32-char-encryption-key
